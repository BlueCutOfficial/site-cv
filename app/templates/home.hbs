<div class="custombox-large">
  <span class="language-bar custombox-large">
    <button type="button"
      aria-label={{t "language.toFR"}}
      {{on "click" (fn this.updateLanguage "fr-fr")}}
    >
      FR
    </button>
    <span>|</span>
    <button type="button"
      aria-label={{t "language.toEN"}}
      {{on "click" (fn this.updateLanguage "en-us")}}
    >
      EN
    </button>
  </span>
  <LinksButtons @model={{@model}} @cvSlots={{@cvSlots}} />
  <ProfileHeader @me={{this.model}} />
</div>
<MenuBar class="menu-bar" @model={{this.model}} @cvSlots={{this.cvSlots}} />
{{outlet}}
